ceVi":"📞 Tư vấn miễn phí, không bắt buộc sử dụng dịch vụ.\n💰 Giải thích rõ ràng về chi phí, không thu thêm ngoài thoả thuận.\n🔒 Bảo mật tuyệt đối thông tin và câu chuyện của gia đình bạn.","hotlineNoticeKo":null,"heroTitleVi":"Chọn nơi an nghỉ cuối cùng một cách bình tĩnh và minh bạch.!","heroSubtitleVi":"Dịch vụ tư vấn do người Hàn Quốc vận hành, hỗ trợ gia đình Việt Nam hiểu rõ chi phí và lựa chọn trước khi ra nghĩa trang.!","heroCtaPrimaryVi":"Gọi tư vấn ngay!","heroCtaSecondaryVi":"Để lại thông tin tư vấn!!","heroCtaTertiaryVi":"Chat qua Zalo!!!","footerMessageVi":"Dịch vụ tư vấn do người Hàn Quốc vận hành!!!!","zaloUrl":null,"facebookUrl":null,"siteNameVi":null,"footerMenuTitleVi":null,"footerMenuNghiaTrangVi":null,"footerMenuAboutVi":null,"footerContactTitleVi":null,"footerSocialTitleVi":null,"footerCertLabelVi":null,"footerCertLogoUrl":null,"seoDefaultTitleVi":null,"seoDefaultDescriptionVi":null,"ogDefaultTitleVi":"JP Haven – Tư vấn nghĩa trang & lưu tro cốt cho gia đình Việt Nam","ogDefaultDescriptionVi":"JP Haven Memorial đồng hành cùng gia đình chuẩn bị nơi an nghỉ cuối cùng một cách bình tĩnh, minh bạch chi phí và dễ dàng so sánh các nghĩa trang tại Việt Nam.","ogDefaultImageUrl":"https://YOUR-DOMAIN.com/og-default.jpg","ogDefaultImageAltVi":"Không gian lưu tro cốt hiện đại, sáng và trang trọng của JP Haven Memorial tại Việt Nam.","termsContentVi":"$b","privacyContentVi":"$c"}}]]

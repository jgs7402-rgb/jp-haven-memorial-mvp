2:["$","main",null,{"className":"mx-auto max-w-5xl p-6 space-y-6","children":[["$","header",null,{"className":"flex items-center justify-between","children":["$","div",null,{"children":[["$","h1",null,{"className":"text-2xl font-bold","children":"장지 관리 (Cemeteries)"}],["$","p",null,{"className":"text-sm text-slate-600","children":"장지 이름, 지역, 타입, 노출 여부, 메인 추천, 이미지 URL 등을 한 화면에서 관리합니다."}]]}]}],["$","$L9",null,{"initialCemeteries":[{"id":6,"region":"Bắc","nameKo":" 하롱 바다 전망 공원묘지","nameVi":"Công viên nghĩa trang biển Hạ Long","typeCode":"Công viên nghĩa trang","addressVi":"Hạ Long Quảng Ninh Việt Nam","addressShortVi":null,"locationShortVi":null,"prosKo":"바다 전망과 자연 경관이 좋은 공원형 묘지","prosVi":"Không gian mở nhìn ra biển với cảnh quan tự nhiên đẹp","extraInfoKo":"하롱만을 내려다보는 언덕에 조성된 공원형 묘지로 탁 트인 바다 풍경과 함께 고인을 떠올리며 시간을 보낼 수 있습니다 바닷바람과 녹지가 어우러져 답답한 느낌 없이 차분하게 머물기 좋습니다","extraInfoVi":"Nghĩa trang được xây dựng trên đồi nhìn xuống vịnh Hạ Long giúp gia đình có thể tưởng nhớ người đã khuất trong khung cảnh biển trời thoáng đãng Gió biển và cây xanh hòa quyện tạo nên cảm giác nhẹ nhàng không quá u ám","isActive":true,"isFeaturedMain":true,"featuredOrderMain":null,"imageUrl":"https://mgqnadogbqjmemzneprt.supabase.co/storage/v1/object/public/cometeries/cemeteries/JP_Memorial/IMG_8696.jpeg","mainImageUrl":"https://mgqnadogbqjmemzneprt.supabase.co/storage/v1/object/public/cometeries/cemeteries/JP_Memorial/IMG_8696.jpeg","lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":"2025-11-29T07:16:05.329+00:00","metaDescriptionVi":null,"images":[]},{"id":1,"region":"Bắc","nameKo":"빈장 공원묘지","nameVi":"Nghĩa trang Bình Dương","typeCode":"Công viên nghĩa trang","addressVi":"Bình Dương, Việt Nam","addressShortVi":null,"locationShortVi":null,"prosKo":"넓은 부지, 관리 우수","prosVi":"Không gian rộng, dịch vụ tốt","extraInfoKo":"넓게 펼쳐진 녹지와 잘 정돈된 산책로가 있어서, 가족들이 천천히 걸으며 추억을 나누기 좋은 곳입니다. 주차 공간과 방문객을 위한 편의 시설도 갖추고 있어, 어렵지 않게 하루를 보내실 수 있습니다.\n","extraInfoVi":"Nghĩa trang được quy hoạch thoáng rộng với nhiều cây xanh và lối đi bộ sạch sẽ, rất phù hợp để gia đình vừa đi dạo vừa trò chuyện về kỷ niệm. Khuôn viên có bãi đỗ xe và khu vực nghỉ chân, giúp việc viếng thăm trở nên nhẹ nhàng và thoải mái hơn.","isActive":true,"isFeaturedMain":true,"featuredOrderMain":null,"imageUrl":"https://mgqnadogbqjmemzneprt.supabase.co/storage/v1/object/public/cometeries/cemeteries/JP_Memorial/IMG_8695%20(1).jpeg","mainImageUrl":"https://mgqnadogbqjmemzneprt.supabase.co/storage/v1/object/public/cometeries/cemeteries/JP_Memorial/IMG_8695%20(1).jpeg","lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":"2025-11-29T06:52:54.153+00:00","metaDescriptionVi":null,"images":[{"id":20,"cemeteryId":1,"imageUrl":"https://mgqnadogbqjmemzneprt.supabase.co/storage/v1/object/public/cometeries/cemeteries/JP_Memorial/IMG_8695%20(1).jpeg","sortOrder":null,"isMain":true,"createdAt":""}]},{"id":5,"region":"Bắc","nameKo":"하노이 가족 납골당","nameVi":"Nhà lưu tro cốt gia đình Hà Nội","typeCode":"Nhà lưu tro cốt","addressVi":"Hà Nội, Việt Nam","addressShortVi":null,"locationShortVi":null,"prosKo":"도심과 가까워 평일·주말 모두 방문이 편리한 가족형 납골당","prosVi":"Gần trung tâm, thuận tiện thăm viếng vào cả ngày thường và cuối tuần","extraInfoKo":"하노이 시내에서 크게 벗어나지 않는 위치라, 부모님이 연세가 있으셔도 이동 부담이 적습니다. 실내형 납골당 구조라 비가 오거나 날씨가 덥더라도 쾌적하게 머무를 수 있습","extraInfoVi":"Nằm không quá xa trung tâm Hà Nội nên việc di chuyển của người lớn tuổi cũng không quá vất vả. Kết cấu nhà lưu tro cốt trong nhà giúp gia đình luôn thấy dễ chịu dù trời mưa hay nắng nóng.","isActive":true,"isFeaturedMain":false,"featuredOrderMain":null,"imageUrl":null,"mainImageUrl":null,"lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":null,"metaDescriptionVi":null,"images":[]},{"id":11,"region":"Bắc","nameKo":"test","nameVi":"test","typeCode":"Công viên nghĩa trang","addressVi":"L5-3.06, Tóa L5 Vinhomes central Park,","addressShortVi":null,"locationShortVi":null,"prosKo":"test1","prosVi":"test1","extraInfoKo":"test2","extraInfoVi":"test2","isActive":true,"isFeaturedMain":false,"featuredOrderMain":null,"imageUrl":"https://mgqnadogbqjmemzneprt.supabase.co/storage/v1/object/public/cometeries/cemeteries/JP_Memorial/IMG_8702.jpeg","mainImageUrl":"https://mgqnadogbqjmemzneprt.supabase.co/storage/v1/object/public/cometeries/cemeteries/JP_Memorial/IMG_8702.jpeg","lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":null,"metaDescriptionVi":null,"images":[]},{"id":9,"region":"Nam","nameKo":"동나이 자연 공원묘지","nameVi":"Công viên nghĩa trang Đồng Nai","typeCode":"Công viên nghĩa trang","addressVi":"Đồng Nai Việt Nam","addressShortVi":null,"locationShortVi":null,"prosKo":"호치민 인근에서 이동 시간이 짧은 대규모 공원형 묘지","prosVi":"Gần TP HCM diện tích rộng dễ đi lại cho gia đình","extraInfoKo":"호치민 인근에 위치해 장거리 이동이 어려운 가족에게 특히 편리합니다 넓은 부지에 구역이 잘 나뉘어 있어 가족묘 구성을 원할 때도 선택지가 다양합니다","extraInfoVi":"Nghĩa trang nằm gần TP HCM phù hợp với gia đình không muốn di chuyển quá xa Khuôn viên rộng chia thành nhiều khu vực rõ ràng giúp dễ dàng chọn ô cho cả gia đình nếu muốn an táng chung một khu","isActive":true,"isFeaturedMain":false,"featuredOrderMain":null,"imageUrl":null,"mainImageUrl":null,"lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":null,"metaDescriptionVi":null,"images":[]},{"id":4,"region":"Nam","nameKo":"호치민 가족 공원묘지","nameVi":"Công viên nghĩa trang gia đình TP.HCM","typeCode":"Công viên nghĩa trang","addressVi":"Ngoại ô TP.HCM, Việt Nam","addressShortVi":null,"locationShortVi":null,"prosKo":"도심에서 1시간 내 접근, 가족 동반 방문에 적합","prosVi":"Cách trung tâm khoảng 1 giờ, phù hợp cho gia đình đi cùng nhau","extraInfoKo":"잔디와 나무가 잘 정돈된 공원형 묘지로, 아이들과 함께 와도 분위기가 너무 무겁지 않도록 설계된 곳입니다. Ho Chi Minh 시내에서 차로 약 1시간 정도 소요되어 주말에 가족 단위로 찾아와 인사드리기에 부담이 적습니다.","extraInfoVi":"Khu nghĩa trang được thiết kế như một công viên xanh, không gian thoáng đãng và nhẹ nhàng, phù hợp cả khi đi cùng trẻ nhỏ. Từ trung tâm TP.HCM di chuyển khoảng 1 giờ bằng ô tô, rất tiện để gia đình sắp xếp thời gian thăm viếng vào cuối tuần.","isActive":true,"isFeaturedMain":false,"featuredOrderMain":null,"imageUrl":null,"mainImageUrl":null,"lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":null,"metaDescriptionVi":null,"images":[]},{"id":3,"region":"Nam","nameKo":"호치민 납골당","nameVi":"Nghĩa trang TP.HCM","typeCode":"Nhà lưu tro cốt","addressVi":"TP.HCM","addressShortVi":null,"locationShortVi":null,"prosKo":"도심 접근성 좋고 방문이 편리함","prosVi":"Gần trung tâm, dễ đi lại cho gia đình","extraInfoKo":"도심과 가까운 위치에 있어 바쁜 일상 속에서도 가족들이 자주 찾아와 인사드리기 좋습니다. 실내 시설과 안내 서비스가 잘 갖춰져 있어 날씨나 계절에 관계없이 편안하게 방문하실 수 있습니다.","extraInfoVi":"Vị trí gần trung tâm thành phố giúp gia đình dễ dàng sắp xếp thời gian ghé thăm thường xuyên. Khu nhà lưu tro cốt được bố trí gọn gàng, có nhân viên hỗ trợ và không gian nghỉ chân, nên mỗi lần viếng đều diễn ra một cách trang trọng và thuận tiện.","isActive":true,"isFeaturedMain":false,"featuredOrderMain":null,"imageUrl":null,"mainImageUrl":null,"lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":null,"metaDescriptionVi":null,"images":[]},{"id":10,"region":"Nam","nameKo":"메콩강 수변 납골당","nameVi":"Nhà lưu tro cốt ven sông Cửu Long","typeCode":"Nhà lưu tro cốt","addressVi":"Khu vực đồng bằng sông Cửu Long Việt Nam","addressShortVi":null,"locationShortVi":null,"prosKo":"강가 풍경을 보며 조용히 머무를 수 있는 수변 납골당","prosVi":"Nhà lưu tro cốt nằm gần sông không gian thoáng và yên bình","extraInfoKo":"강을 따라 바람이 잘 통하는 위치에 있어 야외 데크나 쉼터에서 강물을 바라보며 고인을 떠올리기 좋습니다 지방에 계신 부모님이나 친척이 방문하시기에도 익숙한 메콩 델타 권역입니다","extraInfoVi":"Nhà lưu tro cốt được xây gần bờ sông có không gian thoáng đãng để gia đình ngồi nghỉ trò chuyện và tưởng nhớ người thân trong khung cảnh yên tĩnh Vị trí thuộc vùng đồng bằng sông Cửu Long thuận tiện cho họ hàng sinh sống tại miền Tây đến thăm","isActive":true,"isFeaturedMain":false,"featuredOrderMain":null,"imageUrl":null,"mainImageUrl":null,"lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":null,"metaDescriptionVi":null,"images":[]},{"id":7,"region":"Trung","nameKo":"후에 전통 사찰 묘지","nameVi":"Nghĩa trang chùa truyền thống Huế","typeCode":"Nghĩa trang chùa","addressVi":"Huế Việt Nam","addressShortVi":null,"locationShortVi":null,"prosKo":"사찰 내 전통 양식으로 조성된 조용한 묘역","prosVi":"Không gian yên tĩnh trong khuôn viên chùa mang màu sắc truyền thống","extraInfoKo":"후에의 전통 사찰 안에 위치한 묘역으로 불교식 문화와 조용한 분위기를 중요하게 생각하는 가족에게 잘 어울립니다 제사를 지내거나 기도를 드리기 좋은 작은 법당과 쉼터가 함께 마련되어 있습니다","extraInfoVi":"Nghĩa trang nằm trong khuôn viên chùa cổ ở Huế phù hợp với những gia đình coi trọng không gian tâm linh và văn hóa Phật giáo Bên cạnh khu mộ có gian thờ nơi làm lễ và cầu nguyện trong những dịp giỗ chạp","isActive":true,"isFeaturedMain":true,"featuredOrderMain":null,"imageUrl":"https://mgqnadogbqjmemzneprt.supabase.co/storage/v1/object/public/cometeries/cemeteries/JP_Memorial/IMG_8696.jpeg","mainImageUrl":"https://mgqnadogbqjmemzneprt.supabase.co/storage/v1/object/public/cometeries/cemeteries/JP_Memorial/IMG_8696.jpeg","lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":null,"metaDescriptionVi":null,"images":[]},{"id":2,"region":"Trung","nameKo":"다낭 수목장","nameVi":"Nghĩa trang Đà Nẵng","typeCode":"Nghĩa trang sinh thái","addressVi":"Đà Nẵng","addressShortVi":null,"locationShortVi":null,"prosKo":"자연 경관이 좋고 조용한 분위기","prosVi":"Không gian yên tĩnh, gần gũi với thiên nhiên","extraInfoKo":"자연 속에 조용히 자리 잡은 수목장으로, 숲과 바람, 새소리가 어우러진 분위기에서 차분하게 머물 수 있습니다. 계절마다 풍경이 달라져 다시 찾아왔을 때에도 새로운 위로와 감정을 느끼게 해줍니다.","extraInfoVi":"Nghĩa trang nằm giữa không gian xanh mát, hòa cùng tiếng gió và tiếng chim, mang đến cảm giác bình yên cho gia đình mỗi lần ghé thăm. Cảnh quan thay đổi theo mùa, khiến mỗi lần quay lại đều mang một cảm xúc mới và nhẹ nhàng hơn cho người ở lại.","isActive":true,"isFeaturedMain":false,"featuredOrderMain":null,"imageUrl":null,"mainImageUrl":null,"lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":null,"metaDescriptionVi":null,"images":[]},{"id":8,"region":"Trung","nameKo":"나트랑 바다 수목장","nameVi":"Nghĩa trang sinh thái biển Nha Trang","typeCode":"Nghĩa trang sinh thái","addressVi":"Nha Trang Khánh Hòa Việt Nam","addressShortVi":null,"locationShortVi":null,"prosKo":"바다와 숲이 함께 있는 자연친화 수목장","prosVi":"Không gian sinh thái kết hợp biển và rừng gần gũi với thiên nhiên","extraInfoKo":"묘역 대신 나무와 자연 속에 유골을 모시는 방식으로 자연으로 편안히 돌아가길 바라는 가족에게 잘 맞는 곳입니다 나트랑 바다와 인접해 있어 기일에 맞춰 여행 겸 방문하기에도 좋습니다","extraInfoVi":"Tro cốt được an vị giữa cây xanh và thảm thực vật thay vì mộ đá truyền thống phù hợp với những gia đình muốn người thân trở về với thiên nhiên Gần biển Nha Trang nên gia đình có thể kết hợp chuyến đi tưởng niệm và nghỉ ngơi nhẹ nhàng","isActive":true,"isFeaturedMain":false,"featuredOrderMain":null,"imageUrl":null,"mainImageUrl":null,"lat":null,"lng":null,"createdAt":"2025-11-25T06:28:51.881738+00:00","updatedAt":null,"metaDescriptionVi":null,"images":[]}]}]]}]
